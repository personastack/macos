#!/bin/sh
set -eu
[ "${3:-}" = / ] || exit 1
# Installer is the sole elevation owner. Never follow an existing symlink or
# overwrite a user-writable parent while copying the privileged payload.
check_path() {
    item=$1
    [ ! -L "$item" ] || exit 1
    if [ -e "$item" ]; then
        [ "$(/usr/bin/stat -f %u "$item")" = 0 ] || exit 1
        mode=$(/usr/bin/stat -f %Lp "$item")
        [ "$((0$mode & 022))" = 0 ] || exit 1
    fi
}
for item in /Library /Library/Security /Library/Security/SecurityAgentPlugins \
    '/Library/Application Support' '/Library/Application Support/PersonaStack' \
    '/Library/Application Support/PersonaStack/LockedControlInstaller' \
    '/Library/Application Support/PersonaStack/LockedControlPolicyBaseline.plist'; do
    check_path "$item"
done
bundle=/Library/Security/SecurityAgentPlugins/PersonaStackLockedGrantCandidate.bundle
check_path "$bundle"
if [ -e "$bundle" ]; then
    [ -d "$bundle" ] || exit 1
    unsafe=$(/usr/bin/find "$bundle" \( -type l -o ! -user root -o -perm -0020 -o -perm -0002 \) -print -quit)
    [ -z "$unsafe" ] || exit 1
fi
