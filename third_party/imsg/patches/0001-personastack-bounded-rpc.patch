+import Foundation
+import IMsgCore
+
+extension RPCServer {
+  func handlePersonaStackChats(id: Any?, params raw: [String: Any]) async throws {
+    let params = try RPCParameters(raw, method: "personastack.chats.page", supportedKeys: ["after_chat_rowid", "upper_chat_rowid", "query", "limit"])
+    let after = try personaStackID(params, "after_chat_rowid", defaultValue: "0")
+    let upper = params.contains("upper_chat_rowid") ? try personaStackID(params, "upper_chat_rowid") : nil
+    let store = try await databaseResources.require().store
+    try respondPersonaStack(id: id, result: store.personaStackChats(after: after, upper: upper, query: params.string("query") ?? "", limit: params.integer("limit") ?? 50))
+  }
+
+  func handlePersonaStackChatMetadata(id: Any?, params raw: [String: Any]) async throws {
+    let params = try RPCParameters(raw, method: "personastack.chatMetadata", supportedKeys: ["chat_ids"])
+    guard let IDs = try params.stringArray("chat_ids"), (1...32).contains(IDs.count) else {
+      throw RPCError.invalidParams("chat_ids is required")
+    }
+    let parsed: [Int64]
+    do { parsed = try IDs.map { try MessageStore.personaStackRowID($0, positive: true) } }
+    catch { throw RPCError.invalidParams("chat_ids must be canonical positive decimal IDs") }
+    guard Set(parsed).count == parsed.count else { throw RPCError.invalidParams("chat_ids must be unique") }
+    let store = try await databaseResources.require().store
+    try respondPersonaStack(id: id, result: store.personaStackChatMetadata(chatIDs: parsed))
+  }
+
+  func handlePersonaStackCheckpoint(id: Any?, params raw: [String: Any]) async throws {
+    let params = try RPCParameters(raw, method: "personastack.source_checkpoint", supportedKeys: ["chat_ids", "anchors"])
+    guard let chatIDs = try params.stringArray("chat_ids"), (1...32).contains(chatIDs.count) else { throw RPCError.invalidParams("chat_ids is required") }
+    let anchors: [PersonaStackAnchor]
+    if let values = try params.objectArray("anchors") {
+      guard values.count <= 32 else { throw RPCError.invalidParams("too many anchors") }
+      anchors = try values.map { value in
+        let entry = try RPCParameters(value, method: "anchor", supportedKeys: ["chat_id", "rowid", "guid"])
+        guard let chat = try entry.string("chat_id"), let row = try entry.string("rowid"), let guid = try entry.string("guid") else { throw RPCError.invalidParams("anchor fields are required") }
+        return PersonaStackAnchor(chat_id: chat, rowid: row, guid: guid)
+      }
+    } else { anchors = [] }
+    let store = try await databaseResources.require().store
+    let parsed = try chatIDs.map { try MessageStore.personaStackRowID($0, positive: true) }
+    try respondPersonaStack(id: id, result: store.personaStackCheckpoint(chatIDs: parsed, anchors: anchors))
+  }
+
+  func handlePersonaStackReceive(id: Any?, params raw: [String: Any]) async throws {
+    let params = try RPCParameters(raw, method: "personastack.receive_page", supportedKeys: ["chat_id", "since_rowid", "through_rowid", "limit"])
+    let store = try await databaseResources.require().store
+    let upper = params.contains("through_rowid") ? try personaStackID(params, "through_rowid") : nil
+    try respondPersonaStack(id: id, result: store.personaStackReceive(chatID: personaStackID(params, "chat_id", positive: true), after: personaStackID(params, "since_rowid"), through: upper, limit: params.integer("limit") ?? 100))
+  }
+
+  func handlePersonaStackRecent(id: Any?, params raw: [String: Any]) async throws {
+    let params = try RPCParameters(raw, method: "personastack.recent_messages", supportedKeys: ["chat_id", "limit"])
+    let store = try await databaseResources.require().store
+    try respondPersonaStack(id: id, result: store.personaStackRecent(chatID: personaStackID(params, "chat_id", positive: true), limit: params.integer("limit") ?? 50))
+  }
+
+  private func personaStackID(_ params: RPCParameters, _ field: String, defaultValue: String? = nil, positive: Bool = false) throws -> Int64 {
+    guard let value = try params.string(field) ?? defaultValue else { throw RPCError.invalidParams("\(field) is required") }
+    do { return try MessageStore.personaStackRowID(value, positive: positive) }
+    catch { throw RPCError.invalidParams("\(field) must be a canonical decimal cursor") }
+  }
+
+  private func respondPersonaStack<T: Encodable>(id: Any?, result: T) throws {
+    let data = try JSONEncoder().encode(result)
+    guard data.count <= 1 << 20, let object = try JSONSerialization.jsonObject(with: data) as? [String: Any] else { throw RPCError.internalError("payload_too_large") }
+    respond(id: id, result: object)
+  }
+}
+
+extension RPCServer {
+  // This readiness path never consults the optional IMCore bridge or Contacts.
+  // The host separately verifies the active account through public Apple Events.
+  func handlePersonaStackInitialize(id: Any?, params raw: [String: Any]) async throws {
+    let params = try RPCParameters(raw, method: "personastack.initialize", supportedKeys: ["protocol_version"])
+    if let version = try params.integer("protocol_version"), version != kRPCProtocolVersion {
+      throw RPCError.invalidParams("unsupported protocol_version")
+    }
+    await respondPersonaStackReadiness(id: id)
+  }
+
+  func handlePersonaStackStatus(id: Any?, params raw: [String: Any]) async throws {
+    _ = try RPCParameters(raw, method: "personastack.status", supportedKeys: [])
+    await respondPersonaStackReadiness(id: id)
+  }
+
+  private func respondPersonaStackReadiness(id: Any?) async {
+    let ready = await databaseResources.available() != nil
+    var methods = ["personastack.initialize", "personastack.status"]
+    if ready {
+      methods += ["personastack.chats.page", "personastack.chatMetadata", "personastack.source_checkpoint", "personastack.receive_page", "personastack.recent_messages", "personastack.send"]
+    }
+    respond(id: id, result: ["protocol_version": kRPCProtocolVersion,
+                           "personastack_adapter_revision": MessageStore.personaStackAdapterRevision,
+                           "database": ["ready": ready], "methods": methods])
+  }
+
+  // A dispatch acknowledgement is deliberately not a local message receipt.
+  // Native confirmation reads only the bounded, selected-chat post-tail window.
+  func handlePersonaStackSend(id: Any?, params raw: [String: Any]) async throws {
+    let params = try RPCParameters(raw, method: "personastack.send", supportedKeys: ["chat_id", "chat_guid", "expected_account_id", "text"])
+    let chatID = try personaStackID(params, "chat_id", positive: true)
+    guard let account = try params.string("expected_account_id"), !account.isEmpty, account.utf8.count <= 256,
+          !account.unicodeScalars.contains(where: { CharacterSet.controlCharacters.contains($0) }),
+          let guid = try params.string("chat_guid"), !guid.isEmpty, guid.utf8.count <= 256,
+          let text = try params.string("text"), !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+          text.utf8.count <= 16_384 else { throw RPCError.invalidParams("A selected chat and bounded text are required") }
+    let store = try await databaseResources.require().store
+    let proof = try store.personaStackCheckpoint(chatIDs: [chatID])
+    guard let chat = proof.chats.first, chat.available, chat.guid == guid else {
+      throw RPCError.invalidParams("Selected conversation is unavailable or changed")
+    }
+    try await personaStackSendMessage(MessageSendOptions(recipient: "", text: text,
+      service: .imessage, chatGUID: guid, allowSMSFallback: false), account)
+    respond(id: id, result: ["submitted": true, "transport": "applescript", "service": "iMessage", "chat_guid": guid])
+  }
+}
