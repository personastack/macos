+extension MessageStore {
+  public static let personaStackAdapterRevision = 2
+  private static let personaStackPhysicalLimit = 512
+  private static let personaStackFieldLimit = 1 << 20
+  private static let personaStackOutputLimit = 1 << 20
+
+  public static func personaStackRowID(_ value: String, positive: Bool = false) throws -> Int64 {
+    guard let parsed = Int64(value), parsed >= (positive ? 1 : 0), String(parsed) == value else {
+      throw PersonaStackReadFailure.invalidArguments
+    }
+    return parsed
+  }
+
+  private func personaStackRead<T>(_ body: (Connection, PersonaStackSQLBudget) throws -> T) throws -> T {
+    try withConnection { db in
+      let budget = PersonaStackSQLBudget(db)
+      let oldTimeout = db.busyTimeout
+      db.busyTimeout = 0.05
+      defer { budget.finish(); db.busyTimeout = oldTimeout }
+      // SQLite.swift transaction closures run on its connection queue. Keep
+      // this closure on MessageStore's queue so its metadata helpers can reenter.
+      try db.execute("BEGIN DEFERRED TRANSACTION")
+      do {
+        let result = try body(db, budget)
+        try db.execute("COMMIT")
+        return result
+      } catch {
+        budget.finish()
+        try? db.execute("ROLLBACK")
+        throw error
+      }
+    }
+  }
+
+  public func personaStackChats(after: Int64 = 0, upper: Int64? = nil, query: String = "", limit: Int = 50) throws -> PersonaStackChatPage {
+    guard after >= 0, (1...50).contains(limit), query.count <= 128 else {
+      throw PersonaStackReadFailure.invalidArguments
+    }
+    return try personaStackRead { db, budget in
+      let ceiling = try upper ?? (db.scalar("SELECT IFNULL(MAX(ROWID), 0) FROM chat") as? Int64 ?? 0)
+      guard ceiling >= after else { throw PersonaStackReadFailure.invalidArguments }
+      let rows = try db.prepareRowIterator("SELECT ROWID AS id FROM chat WHERE ROWID > ? AND ROWID <= ? ORDER BY ROWID LIMIT 512", bindings: [after, ceiling])
+      var output: [PersonaStackChat] = []
+      var cursor = after
+      var examined = 0
+      var bytes = 512
+      var reason = PersonaStackStopReason.caughtUp
+      while let row = try rows.failableNext() {
+        if budget.elapsed { reason = .timeLimit; break }
+        let rowID = try int64Value(row, "id") ?? 0
+        guard let chat = try personaStackChat(rowID, db: db) else { cursor = rowID; examined += 1; continue }
+        let matches = query.isEmpty || ([chat.name] + chat.participants).contains { $0.localizedCaseInsensitiveContains(query) }
+        if matches {
+          let size = try JSONEncoder().encode(chat).count
+          if bytes + size > Self.personaStackOutputLimit || output.count == limit {
+            reason = .outputLimit; break
+          }
+          output.append(chat); bytes += size
+        }
+        cursor = rowID; examined += 1
+      }
+      let more = (try db.scalar("SELECT EXISTS(SELECT 1 FROM chat WHERE ROWID > ? AND ROWID <= ?)", cursor, ceiling) as? Int64 ?? 0) != 0
+      if more && reason == .caughtUp { reason = .scanLimit }
+      return PersonaStackChatPage(chats: output, next_chat_rowid: String(cursor), upper_chat_rowid: String(ceiling), has_more: more, stop_reason: reason)
+    }
+  }
+
+  public func personaStackChatMetadata(chatIDs: [Int64]) throws -> PersonaStackChatMetadata {
+    guard (1...32).contains(chatIDs.count), Set(chatIDs).count == chatIDs.count,
+          chatIDs.allSatisfy({ $0 > 0 }) else { throw PersonaStackReadFailure.invalidArguments }
+    return try personaStackRead { db, timeBudget in
+      let rowBudget = PersonaStackMetadataBudget()
+      var chats: [PersonaStackChat] = []
+      var bytes = 32
+      for chatID in chatIDs {
+        guard !timeBudget.elapsed else { throw PersonaStackReadFailure.timeLimit }
+        let candidate = try personaStackChat(chatID, db: db, metadataBudget: rowBudget)
+        let chat: PersonaStackChat
+        if let candidate, candidate.available, !candidate.guid.isEmpty { chat = candidate }
+        else { chat = Self.personaStackUnavailableChat(chatID) }
+        bytes += try JSONEncoder().encode(chat).count + 1
+        guard bytes <= Self.personaStackOutputLimit else { throw PersonaStackReadFailure.payloadTooLarge }
+        chats.append(chat)
+      }
+      guard !timeBudget.elapsed else { throw PersonaStackReadFailure.timeLimit }
+      return PersonaStackChatMetadata(chats: chats)
+    }
+  }
+
+  private static func personaStackUnavailableChat(_ chatID: Int64) -> PersonaStackChat {
+    PersonaStackChat(id: String(chatID), guid: "", name: "", service: "", is_group: false,
+                     available: false, participants: [], account_id: nil, account_login: nil)
+  }
+
+  // Identity queries never select message content. A single read transaction
+  // samples all requested chat anchors and the global insertion boundary.
+  public func personaStackCheckpoint(chatIDs: [Int64], anchors: [PersonaStackAnchor] = []) throws -> PersonaStackCheckpoint {
+    guard (1...32).contains(chatIDs.count), Set(chatIDs).count == chatIDs.count, chatIDs.allSatisfy({ $0 > 0 }), anchors.count <= 32 else {
+      throw PersonaStackReadFailure.invalidArguments
+    }
+    var parsedAnchors: [Int64: (Int64, String)] = [:]
+    for anchor in anchors {
+      let chat = try Self.personaStackRowID(anchor.chat_id, positive: true)
+      let row = try Self.personaStackRowID(anchor.rowid)
+      guard chatIDs.contains(chat), parsedAnchors[chat] == nil, anchor.guid.utf8.count <= 256 else { throw PersonaStackReadFailure.invalidArguments }
+      parsedAnchors[chat] = (row, anchor.guid)
+    }
+    return try personaStackRead { db, budget in
+      var result: PersonaStackCheckpoint?
+      do {
+        let high = try db.scalar("SELECT IFNULL(MAX(ROWID), 0) FROM message") as? Int64 ?? 0
+        var chats: [PersonaStackChatCheckpoint] = []
+        for chatID in chatIDs {
+          guard !budget.elapsed else { throw PersonaStackReadFailure.timeLimit }
+          let info = try personaStackChatInfo(chatID, db: db)
+          let available = info?.service.caseInsensitiveCompare("iMessage") == .orderedSame
+          var tail: Int64 = 0
+          var guid = ""
+          if available {
+            let rows = try db.prepareRowIterator("SELECT m.ROWID AS id, CASE WHEN length(CAST(m.guid AS BLOB)) <= 256 THEN IFNULL(m.guid, '') ELSE '' END AS guid FROM message m JOIN chat_message_join j ON j.message_id = m.ROWID WHERE j.chat_id = ? ORDER BY m.ROWID DESC LIMIT 1", bindings: [chatID])
+            if let row = try rows.failableNext() { tail = try int64Value(row, "id") ?? 0; guid = try stringValue(row, "guid") }
+          }
+          var matches: Bool?
+          if let (rowID, oldGUID) = parsedAnchors[chatID] {
+            if rowID == 0 { matches = available && oldGUID.isEmpty }
+            else {
+              let found = try db.scalar("SELECT m.guid FROM message m JOIN chat_message_join j ON j.message_id = m.ROWID WHERE j.chat_id = ? AND m.ROWID = ? LIMIT 1", chatID, rowID) as? String
+              matches = available && found == oldGUID
+            }
+          }
+          chats.append(PersonaStackChatCheckpoint(chat_id: String(chatID), guid: info?.guid ?? "", service: info?.service ?? "", available: available, tail_rowid: String(tail), tail_guid: guid, account_id: info?.accountID, account_login: info?.accountLogin, anchor_matches: matches))
+        }
+        result = PersonaStackCheckpoint(adapter_revision: Self.personaStackAdapterRevision, source_high_water: String(high), chats: chats, observed_at: ISO8601DateFormatter().string(from: Date()))
+      }
+      guard let result else { throw PersonaStackReadFailure.sourceUnavailable }
+      return result
+    }
+  }
+
+  public func personaStackReceive(chatID: Int64, after: Int64, through: Int64? = nil, limit: Int = 100) throws -> PersonaStackReceivePage {
+    guard chatID > 0, after >= 0, through.map({ $0 >= after }) ?? true, (1...100).contains(limit) else { throw PersonaStackReadFailure.invalidArguments }
+    return try personaStackRead { db, budget in
+      try personaStackRequireChat(chatID, db: db)
+      let sourceHigh = try db.scalar("SELECT IFNULL(MAX(ROWID), 0) FROM message") as? Int64 ?? 0
+      guard sourceHigh >= after else { throw PersonaStackReadFailure.sourceUnavailable }
+      let ceiling = min(through ?? sourceHigh, sourceHigh)
+      let rows = try db.prepareRowIterator("SELECT m.ROWID AS id FROM message m JOIN chat_message_join j ON j.message_id = m.ROWID WHERE j.chat_id = ? AND m.ROWID > ? AND m.ROWID <= ? ORDER BY m.ROWID LIMIT 512", bindings: [chatID, after, ceiling])
+      var output: [PersonaStackMessage] = []
+      var cursor = after
+      var bytes = 512
+      var reason = PersonaStackStopReason.caughtUp
+      var remaining = Self.personaStackPhysicalLimit
+      while let row = try rows.failableNext() {
+        if budget.elapsed { reason = .timeLimit; break }
+        if remaining == 0 { reason = .scanLimit; break }
+        remaining -= 1
+        let rowID = try int64Value(row, "id") ?? 0
+        if let record = try personaStackMessage(rowID, chatID: chatID, db: db) {
+          let decision = try personaStackPreview(record, db: db, remaining: &remaining)
+          if decision == .deferPage { reason = .scanLimit; break }
+          if decision == .keep {
+            let size = try JSONEncoder().encode(record.payload).count
+            if output.count == limit || bytes + size > Self.personaStackOutputLimit { reason = .outputLimit; break }
+            output.append(record.payload); bytes += size
+          }
+        }
+        cursor = rowID
+      }
+      let more = (try db.scalar("SELECT EXISTS(SELECT 1 FROM chat_message_join WHERE chat_id = ? AND message_id > ? AND message_id <= ?)", chatID, cursor, ceiling) as? Int64 ?? 0) != 0
+      if more && reason == .caughtUp { reason = .scanLimit }
+      return PersonaStackReceivePage(messages: output, next_rowid: String(cursor), has_more: more, stop_reason: reason)
+    }
+  }
+
+  public func personaStackRecent(chatID: Int64, limit: Int = 50) throws -> PersonaStackRecentPage {
+    guard chatID > 0, (1...100).contains(limit) else { throw PersonaStackReadFailure.invalidArguments }
+    return try personaStackRead { db, budget in
+      try personaStackRequireChat(chatID, db: db)
+      let rows = try db.prepareRowIterator("SELECT m.ROWID AS id FROM message m JOIN chat_message_join j ON j.message_id = m.ROWID WHERE j.chat_id = ? ORDER BY m.date DESC, m.ROWID DESC LIMIT 512", bindings: [chatID])
+      var output: [PersonaStackMessage] = []
+      var reason = PersonaStackStopReason.caughtUp
+      var bytes = 512
+      var remaining = Self.personaStackPhysicalLimit
+      var truncated = false
+      while let row = try rows.failableNext() {
+        if budget.elapsed { truncated = true; reason = .timeLimit; break }
+        if remaining == 0 { truncated = true; reason = .scanLimit; break }
+        remaining -= 1
+        if let record = try personaStackMessage(try int64Value(row, "id") ?? 0, chatID: chatID, db: db) {
+          let decision = try personaStackPreview(record, db: db, remaining: &remaining)
+          if decision == .deferPage { truncated = true; reason = .scanLimit; break }
+          if decision == .keep {
+            let size = try JSONEncoder().encode(record.payload).count
+            if output.count == limit || bytes + size > Self.personaStackOutputLimit { truncated = true; reason = .outputLimit; break }
+            output.append(record.payload); bytes += size
+          }
+        }
+      }
+      if remaining == 0 { truncated = true; reason = .scanLimit }
+      return PersonaStackRecentPage(messages: Array(output.reversed()), truncated: truncated, stop_reason: reason)
+    }
+  }
