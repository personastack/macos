+  private func personaStackMessage(_ rowID: Int64, chatID: Int64, db: Connection) throws -> PersonaStackDecodedMessage? {
+    let body = schema.hasAttributedBody ? "m.attributedBody" : "NULL"
+    let reaction = schema.hasReactionColumns ? "m.associated_message_type" : "0"
