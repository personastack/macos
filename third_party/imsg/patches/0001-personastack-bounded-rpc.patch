+private final class PersonaStackRPCState: @unchecked Sendable {
+  private let lock = NSLock()
+  private var counts: [String: Int] = [:]
+  private var statements: [String] = []
+  private var sentOptions: MessageSendOptions?
+  func count(_ key: String) { lock.lock(); defer { lock.unlock() }; counts[key, default: 0] += 1 }
+  func countFor(_ key: String) -> Int { lock.lock(); defer { lock.unlock() }; return counts[key, default: 0] }
+  func trace(_ sql: String) { lock.lock(); defer { lock.unlock() }; statements.append(sql) }
+  var queries: [String] { lock.lock(); defer { lock.unlock() }; return statements }
+  func sent(_ options: MessageSendOptions) { lock.lock(); defer { lock.unlock() }; sentOptions = options; counts["send", default: 0] += 1 }
+  var options: MessageSendOptions? { lock.lock(); defer { lock.unlock() }; return sentOptions }
+}
+
+private final class PersonaStackRPCOutput: RPCOutput, @unchecked Sendable {
+  private let lock = NSLock()
+  private var resultStorage: [[String: Any]] = []
+  private var errorStorage: [[String: Any]] = []
+  var results: [[String: Any]] { lock.lock(); defer { lock.unlock() }; return resultStorage }
+  var errors: [[String: Any]] { lock.lock(); defer { lock.unlock() }; return errorStorage }
+  func sendResponse(id: Any, result: Any) { lock.lock(); defer { lock.unlock() }; resultStorage.append(result as? [String: Any] ?? [:]) }
+  func sendError(id: Any?, error: RPCError) { lock.lock(); defer { lock.unlock() }; errorStorage.append(error.asDictionary()) }
+  func sendNotification(method: String, params: Any) {}
+  func flush() {}
+}
+
+private final class PersonaStackContactSpy: ContactResolving, Sendable {
+  let state: PersonaStackRPCState
+  init(_ state: PersonaStackRPCState) { self.state = state }
+  var contactsUnavailable: Bool { state.count("contacts"); return false }
+  var cached: any ContactResolving { state.count("contacts"); return self }
+  func displayName(for handle: String) -> String? { state.count("contacts"); return nil }
+  func displayNames(for handles: [String]) -> [String: String] { state.count("contacts"); return [:] }
+  func searchByName(_ query: String) -> [ContactMatch] { state.count("contacts"); return [] }
+}
