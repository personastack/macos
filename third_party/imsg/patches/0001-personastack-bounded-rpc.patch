+import Foundation
+
+struct PersonaStackTextInvocation: Sendable {
+  let source: String
+  let arguments: [String]
+}
+
+/// Public AppleScript executes in the already owned provider process. No helper
+/// process can escape its process group or survive the host's deadline cleanup.
+public enum PersonaStackAppleScriptTransport {
+  static let source = """
+    on personastacksend(chatGUID, messageText, expectedAccountID)
+      set dispatchStarted to false
+      try
+        tell application "/System/Applications/Messages.app"
+          set targetChat to get chat id chatGUID
+          considering case
+            if (id of targetChat) is not chatGUID then return "PSTACK_NOT_STARTED"
+          end considering
+          set targetAccount to account of targetChat
+          considering case
+            if (id of targetAccount) is not expectedAccountID then return "PSTACK_NOT_STARTED"
+          end considering
+          if (service type of targetAccount) is not iMessage then return "PSTACK_NOT_STARTED"
+          if (enabled of targetAccount) is not true then return "PSTACK_NOT_STARTED"
+          if (connection status of targetAccount) is not connected then return "PSTACK_NOT_STARTED"
+          set dispatchStarted to true
+          send messageText to targetChat
+        end tell
+        return "PSTACK_SUBMITTED"
+      on error
+        if dispatchStarted then
+          return "PSTACK_OUTCOME_UNKNOWN"
+        end if
+        return "PSTACK_NOT_STARTED"
+      end try
+    end personastacksend
+    """
+
+  static func prepare(_ options: MessageSendOptions, expectedAccountID: String) throws -> PersonaStackTextInvocation {
+    guard !expectedAccountID.isEmpty, expectedAccountID.utf8.count <= 256,
+          !expectedAccountID.unicodeScalars.contains(where: { CharacterSet.controlCharacters.contains($0) }),
+          options.service == .imessage, !options.allowSMSFallback,
+          !options.chatGUID.isEmpty, options.chatGUID.utf8.count <= 256,
+          options.chatIdentifier.isEmpty, options.recipient.isEmpty,
+          options.attachmentPath.isEmpty, options.directParticipantTarget == nil,
+          !options.text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+          options.text.utf8.count <= 16_384 else {
+      throw failure(.notStarted, "A fixed selected iMessage conversation and bounded text are required.")
+    }
+    return PersonaStackTextInvocation(source: source, arguments: [options.chatGUID, options.text, expectedAccountID])
+  }
+
+  public static func send(_ options: MessageSendOptions, expectedAccountID: String) async throws {
+    let invocation = try prepare(options, expectedAccountID: expectedAccountID)
+    #if os(macOS)
+      try await execute(invocation)
+    #else
+      _ = invocation
+      throw failure(.notStarted, "Messages automation requires macOS.")
+    #endif
+  }
+
+  #if os(macOS)
+    @MainActor
+    private static func execute(_ invocation: PersonaStackTextInvocation) throws {
+      guard let script = NSAppleScript(source: invocation.source) else {
+        throw failure(.notStarted, "The fixed Messages script could not be loaded.")
+      }
+      var error: NSDictionary?
+      guard script.compileAndReturnError(&error) else {
+        throw failure(.notStarted, "The fixed Messages script could not be compiled.")
+      }
+      // Invoke a handler in this script, with data descriptors for all three values.
+      // No user-provided text is ever interpolated into AppleScript source.
+      let arguments = NSAppleEventDescriptor.list()
+      for (offset, argument) in invocation.arguments.enumerated() {
+        arguments.insert(NSAppleEventDescriptor(string: argument), at: offset + 1)
+      }
+      let event = NSAppleEventDescriptor(eventClass: 0x61736372, eventID: 0x70736272,
+        targetDescriptor: nil, returnID: -1, transactionID: 0)
+      event.setParam(NSAppleEventDescriptor(string: "personastacksend"), forKeyword: 0x736e616d)
+      event.setParam(arguments, forKeyword: 0x2d2d2d2d)
+      error = nil
+      let result: NSAppleEventDescriptor? = script.executeAppleEvent(event, error: &error)
+      guard error == nil else {
+        throw failure(.mayHaveCompleted, "Messages execution ended without a confirmed dispatch result.")
+      }
+      switch result?.stringValue {
+      case "PSTACK_SUBMITTED": return
+      case "PSTACK_NOT_STARTED": throw failure(.notStarted, "The selected Messages conversation was unavailable before dispatch.")
+      default: throw failure(.mayHaveCompleted, "Messages may have accepted the text.")
+      }
+    }
+  #endif
+
+  private static func failure(_ disposition: DeliveryDisposition, _ detail: String) -> DeliveryFailure {
+    DeliveryFailure(disposition: disposition, transport: .appleScript,
+                    operation: "personastack.send", detail: detail)
+  }
+}
