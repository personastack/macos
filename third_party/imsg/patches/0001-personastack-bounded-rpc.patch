+private enum PersonaStackPreviewDecision: Equatable { case keep, suppress, deferPage }
+
+// Conservative accounting charges both fixed metadata queries even for a missing
+// row. Participant records share this budget across all exact selected IDs.
+private final class PersonaStackMetadataBudget {
+  private(set) var remaining = 512
+  func requireRoom() throws {
+    guard remaining > 0 else { throw PersonaStackReadFailure.payloadTooLarge }
+  }
+  func consume(_ count: Int = 1) throws {
+    guard count <= remaining else { throw PersonaStackReadFailure.payloadTooLarge }
+    remaining -= count
+  }
+}
+
+// This guard owns the only pending interrupt. Cancellation waits for an interrupt
+// already in progress, so it cannot interrupt the next caller on the store queue.
+private final class PersonaStackSQLBudget: @unchecked Sendable {
+  private let lock = NSLock()
+  private let connection: Connection
+  private var active = true
+  private var work: DispatchWorkItem?
+  let started = DispatchTime.now().uptimeNanoseconds
+  init(_ connection: Connection) {
+    self.connection = connection
+    let item = DispatchWorkItem { [weak self] in self?.interruptIfActive() }
+    work = item
+    DispatchQueue.global(qos: .utility).asyncAfter(deadline: .now() + 1, execute: item)
+  }
+  var elapsed: Bool { DispatchTime.now().uptimeNanoseconds - started >= 1_000_000_000 }
+  func finish() {
+    lock.lock(); defer { lock.unlock() }
+    active = false; work?.cancel(); work = nil
+  }
+  private func interruptIfActive() {
+    lock.lock(); defer { lock.unlock() }
+    if active { connection.interrupt() }
+  }
+}
