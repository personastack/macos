+  // Each proof examines at most 32 predecessors and shares the caller's 512
+  // physical-record budget. Unproven or unmatched URL content is retained.
+  private func personaStackPreview(_ record: PersonaStackDecodedMessage, db: Connection, remaining: inout Int) throws -> PersonaStackPreviewDecision {
+    guard isURLPreviewBalloon(record.semantic), !record.payload.text_truncated else { return .keep }
+    guard remaining > 0 else { return .deferPage }
+    let maximum = min(32, remaining)
+    let rows = try db.prepareRowIterator("SELECT message_id AS id FROM chat_message_join WHERE chat_id = ? AND message_id < ? ORDER BY message_id DESC LIMIT ?", bindings: [record.semantic.chatID, record.semantic.rowID, maximum])
+    var previews = [record.semantic]
+    while let row = try rows.failableNext() {
+      remaining -= 1
+      let prior: PersonaStackDecodedMessage?
+      do { prior = try personaStackMessage(try int64Value(row, "id") ?? 0, chatID: record.semantic.chatID, db: db) }
+      catch PersonaStackReadFailure.payloadTooLarge { return .keep }
+      guard let prior, !prior.payload.text_truncated else { return .keep }
+      if isURLPreviewBalloon(prior.semantic) { previews.append(prior.semantic); continue }
+      return previews.allSatisfy { canCoalesceURLPreview(textMessage: prior.semantic, previewMessage: $0) } ? .suppress : .keep
+    }
+    return .keep
+  }
+
+  private func personaStackBoundedColumn(_ expression: String) -> String {
+    "CASE WHEN IFNULL(length(CAST(\(expression) AS BLOB)), 0) <= 256 THEN IFNULL(\(expression), '') ELSE '' END"
+  }
+
+  private func personaStackText(_ row: Row) throws -> PersonaStackTextState {
+    let raw = try stringValue(row, "text")
+    let edited = (try int64Value(row, "edited") ?? 0) > 0 ? try appleDate(from: int64Value(row, "edited")) : nil
+    let unsent = (try int64Value(row, "retracted") ?? 0) > 0 ? try appleDate(from: int64Value(row, "retracted")) : nil
+    let body = try dataValue(row, "body")
+    let resolved = unsent != nil ? "" : ((raw.isEmpty || (edited != nil && !body.isEmpty)) ? TypedStreamParser.parseAttributedBody(body) : raw)
+    var text = ""
+    var bytes = 0
+    for character in resolved {
+      let size = String(character).utf8.count
+      if bytes + size > 16_384 { break }
+      text.append(character); bytes += size
+    }
+    return PersonaStackTextState(text: text, truncated: text != resolved, editedAt: edited, unsentAt: unsent)
+  }
+
+  private func personaStackSender(_ row: Row, outgoing: Bool) throws -> String {
+    let handle = try stringValue(row, "handle")
+    let caller = try stringValue(row, "caller")
+    // h.id is the recipient for outgoing rows, never a fallback local identity.
+    if outgoing && caller.isEmpty { return "" }
+    if !outgoing && handle.isEmpty { return "" }
+    return try stringValue(row, "sender")
+  }
