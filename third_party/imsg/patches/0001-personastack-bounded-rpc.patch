+  private func personaStackRequireChat(_ chatID: Int64, db: Connection) throws {
+    guard let info = try personaStackChatInfo(chatID, db: db), info.service.caseInsensitiveCompare("iMessage") == .orderedSame else { throw PersonaStackReadFailure.sourceUnavailable }
+  }
+
+  private func personaStackChat(_ chatID: Int64, db: Connection, metadataBudget: PersonaStackMetadataBudget? = nil) throws -> PersonaStackChat? {
+    guard let info = try personaStackChatInfo(chatID, db: db, metadataBudget: metadataBudget) else {
+      try metadataBudget?.consume()
+      let service = try db.scalar("SELECT CASE WHEN length(CAST(service_name AS BLOB)) <= 256 THEN service_name ELSE '' END FROM chat WHERE ROWID = ?", chatID) as? String
+      guard service?.caseInsensitiveCompare("iMessage") == .orderedSame else { return nil }
+      return PersonaStackChat(id: String(chatID), guid: "", name: "Unavailable conversation", service: "iMessage", is_group: false, available: false, participants: [], account_id: nil, account_login: nil)
+    }
+    guard info.service.caseInsensitiveCompare("iMessage") == .orderedSame else { return nil }
+    let rows = try db.prepareRowIterator("SELECT substr(h.id, 1, 257) AS participant FROM handle h JOIN chat_handle_join j ON j.handle_id = h.ROWID WHERE j.chat_id = ? ORDER BY h.ROWID LIMIT 101", bindings: [chatID])
+    var participants: [String] = []
+    while true {
+      try metadataBudget?.requireRoom()
+      guard let row = try rows.failableNext() else { break }
+      try metadataBudget?.consume()
+      let participant = try stringValue(row, "participant")
+      guard !participant.isEmpty, participant.utf8.count <= 256, participants.count < 100 else { return PersonaStackChat(id: String(chatID), guid: info.guid, name: info.name, service: "iMessage", is_group: true, available: false, participants: [], account_id: info.accountID, account_login: info.accountLogin) }
+      participants.append(participant)
+    }
+    guard info.name.utf8.count <= 256, info.guid.utf8.count <= 256 else { throw PersonaStackReadFailure.payloadTooLarge }
+    return PersonaStackChat(id: String(chatID), guid: info.guid, name: info.name, service: "iMessage", is_group: info.guid.contains(";+;") || info.identifier.contains(";+;"), available: true, participants: participants, account_id: info.accountID, account_login: info.accountLogin)
+  }
+
+  private func personaStackChatInfo(_ chatID: Int64, db: Connection, metadataBudget: PersonaStackMetadataBudget? = nil) throws -> ChatInfo? {
+    try metadataBudget?.consume(2)
+    var fields = ["guid", "display_name", "chat_identifier", "service_name"]
+    if schema.hasChatAccountIDColumn { fields.append("account_id") }
+    if schema.hasChatAccountLoginColumn { fields.append("account_login") }
+    if schema.hasChatLastAddressedHandleColumn { fields.append("last_addressed_handle") }
+    let checks = fields.map { "IFNULL(length(CAST(\($0) AS BLOB)), 0) <= 256" }.joined(separator: " AND ")
+    guard (try db.scalar("SELECT (\(checks)) FROM chat WHERE ROWID = ?", chatID) as? Int64) == 1 else { return nil }
+    return try chatInfo(chatID: chatID)
+  }
